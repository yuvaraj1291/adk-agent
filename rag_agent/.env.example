# --- Gemini via Vertex AI (uses your gcloud Application Default Credentials) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Location for the Gemini model. Newer Gemini models may require "global".
GOOGLE_CLOUD_LOCATION=global

# Model used by the agent.
AGENT_MODEL=gemini-3.6-flash

# --- Vertex AI Vector Search (filled in by scripts/setup_vector_search.py) ---
# Region of the index/endpoint (also used for the embedding model).
VECTOR_SEARCH_LOCATION=us-central1
# Full resource name or numeric ID of the index endpoint.
VECTOR_SEARCH_INDEX_ENDPOINT=
# Deployed index ID on that endpoint.
VECTOR_SEARCH_DEPLOYED_INDEX_ID=
# Full resource name or numeric ID of the index (only needed for ingestion).
VECTOR_SEARCH_INDEX=

# Embedding model. Must match the dimensions the index was created with.
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIMENSIONS=768
# Number of chunks to retrieve per query.
VECTOR_SEARCH_TOP_K=5
